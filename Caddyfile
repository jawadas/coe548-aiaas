# The edge of the AIaaS platform: TLS and routing for
# https://coe548.spaincentral.cloudapp.azure.com
#
#   /v1/chat/completions, /v1/models, /v1/models/*  ->  LiteLLM gateway
#   any other /v1 path                              ->  JSON 404, from Caddy
#   everything else                                 ->  portal
#
# The gateway serves much more under /v1 than model inference: /v1/model/info
# hands the GPU pod's address to anyone holding a key, and the management
# routes live there too. So only the three routes the platform offers are let
# through, and no other /v1 request ever reaches the gateway.
#
# Caddyfile.dev is the local copy of this file. The (routes) block must stay
# identical in both.
#
# To apply a change on the VM, run scripts/deploy.sh. "docker compose up -d"
# does not make a running Caddy read this file again.

# Headers on every response, whoever produced it. No Server or Via: there is
# no need to announce what runs here.
(edge_headers) {
	header {
		Strict-Transport-Security "max-age=15552000"
		-Server
		-Via
	}
}

(routes) {
	import edge_headers

	# The API namespace. Nothing in here falls through to the portal.
	@api path /v1 /v1/*
	handle @api {
		@model_routes path /v1/chat/completions /v1/models /v1/models/*
		handle @model_routes {
			reverse_proxy litellm:4000 {
				# Pass streamed tokens on as they arrive.
				flush_interval -1

				# The gateway describes its upstream in response headers
				# (x-litellm-model-api-base is the GPU pod's address). Users
				# get the standard headers and x-ratelimit-* only.
				header_down -X-Litellm-*
				header_down -Llm_provider-*
			}
		}

		handle {
			header Content-Type application/json
			respond `{"error":{"message":"Unknown API route. See /docs for the supported endpoints.","type":"invalid_request_error","param":null,"code":"404"}}` 404
		}
	}

	# Everything else is the portal.
	handle {
		# Compress pages and static files, never the chat stream.
		@compressible not path /api/chat/*
		encode @compressible zstd gzip

		reverse_proxy portal:8000 {
			flush_interval -1
		}
	}

	# A backend cannot be reached: it is down, restarting or still building.
	handle_errors {
		import edge_headers

		@unreachable expression `{err.status_code} in [502, 503, 504]`
		handle @unreachable {
			header Cache-Control no-store
			header Retry-After 10

			# API clients, and the portal's own fetch() calls, get JSON.
			@json path /v1 /v1/* /api/*
			handle @json {
				header Content-Type application/json
				respond `{"error":{"message":"The service is temporarily unavailable. Try again in a moment.","type":"service_unavailable","param":null,"code":"503"}}` 503
			}

			# People get a page that reloads itself until the portal is back.
			handle {
				header Content-Type "text/html; charset=utf-8"
				respond <<HTML
					<!doctype html>
					<html lang="en">
					<head>
					<meta charset="utf-8">
					<meta name="viewport" content="width=device-width, initial-scale=1">
					<meta http-equiv="refresh" content="10">
					<meta name="robots" content="noindex">
					<title>Back in a moment</title>
					<style>
					:root { color-scheme: light dark; --bg: #f5f6f8; --card: #ffffff; --line: #e2e5ea; --text: #15181e; --muted: #5d6675; --accent: #4f46e5; }
					@media (prefers-color-scheme: dark) {
					:root { --bg: #0d0f13; --card: #161920; --line: #262b35; --text: #eceef2; --muted: #9aa3b2; --accent: #8f8ffa; }
					}
					* { box-sizing: border-box; }
					body { margin: 0; min-height: 100vh; display: grid; place-items: center; padding: 24px; background: var(--bg); color: var(--text); font: 16px/1.55 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; }
					main { width: 100%; max-width: 420px; padding: 36px 32px; text-align: center; background: var(--card); border: 1px solid var(--line); border-radius: 16px; }
					.pulse { width: 12px; height: 12px; margin: 0 auto 20px; border-radius: 50%; background: var(--accent); animation: pulse 1.6s ease-in-out infinite; }
					@keyframes pulse { 0%, 100% { opacity: .3; transform: scale(.85); } 50% { opacity: 1; transform: scale(1); } }
					@media (prefers-reduced-motion: reduce) { .pulse { animation: none; } }
					h1 { margin: 0 0 8px; font-size: 20px; font-weight: 650; letter-spacing: -.01em; }
					p { margin: 0; color: var(--muted); }
					p + p { margin-top: 16px; padding-top: 16px; border-top: 1px solid var(--line); font-size: 14px; }
					code { font: 13px ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; color: var(--text); }
					</style>
					</head>
					<body>
					<main>
					<div class="pulse" aria-hidden="true"></div>
					<h1>Back in a moment</h1>
					<p>The portal is restarting. This page reloads by itself.</p>
					<p>API keys keep working: requests to <code>/v1</code> do not go through the portal.</p>
					</main>
					</body>
					</html>
					HTML 503
			}
		}
	}
}

coe548.spaincentral.cloudapp.azure.com {
	import routes
}
