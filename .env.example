POSTGRES_PASSWORD=changeme
LITELLM_MASTER_KEY=changeme
VLLM_API_BASE=changeme
VLLM_API_KEY=changeme

# --- User portal ---
# On the VM, scripts/deploy.sh generates any of the next three that are missing.

# Password of the "portal" database role. Letters, digits and . _ ~ - only,
# because it is placed in a connection URL. Generate: openssl rand -hex 24
PORTAL_DB_PASSWORD=changeme

# Signs sessions and encrypts stored secrets. At least 32 characters.
# Generate: openssl rand -hex 32. Do not change it once people have accounts.
PORTAL_SECRET_KEY=changeme

# People need this code to sign up. Leave it empty to close sign-up.
PORTAL_INVITE_CODE=changeme

# Optional: these addresses are always admins (comma-separated).
# PORTAL_ADMIN_EMAILS=you@example.com

# Optional: the public address of the site, scheme and host only.
# Default: https://coe548.spaincentral.cloudapp.azure.com
# PORTAL_PUBLIC_URL=https://portal.example.com
